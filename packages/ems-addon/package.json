    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@citrineos/base": "workspace:*",
    "@citrineos/types": "workspace:*",
    "fastify": "catalog:",
