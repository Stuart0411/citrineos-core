# Copy this file to deploy/citrine.runtime.env and set real values.
# Required before running deploy.ps1.

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=all
APP_ENV=docker

# ── Database strategy: migrate | sync | force-sync | none ────────────────────
DB_STRATEGY=migrate

# ── Database connection ───────────────────────────────────────────────────────
BOOTSTRAP_CITRINEOS_DATABASE_HOST=ocpp-db
BOOTSTRAP_CITRINEOS_DATABASE_PORT=5432
BOOTSTRAP_CITRINEOS_DATABASE_NAME=citrine
BOOTSTRAP_CITRINEOS_DATABASE_USER=citrine
BOOTSTRAP_CITRINEOS_DATABASE_PASSWORD=citrine

# ── Config file ───────────────────────────────────────────────────────────────
BOOTSTRAP_CITRINEOS_CONFIG_FILENAME=config.json

# ── File storage ──────────────────────────────────────────────────────────────
# Options: local | s3
BOOTSTRAP_CITRINEOS_FILE_ACCESS_TYPE=local
BOOTSTRAP_CITRINEOS_FILE_ACCESS_LOCAL_DEFAULT_FILE_PATH=/data

# For S3 / MinIO:
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me

# ── Optional ─────────────────────────────────────────────────────────────────
# Wipe system config on start (set true only for first-run reset)
CONFIG_CITRINEOS_WIPE_FILE_ON_START=false
