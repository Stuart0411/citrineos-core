# EMS add-on environment template
# Copy to deploy/ems-addon/.env and adapt values per environment.

EMS_ADDON_HTTP_HOST=0.0.0.0
EMS_ADDON_HTTP_PORT=8095
EMS_ADDON_LOG_LEVEL=info
EMS_ADDON_INTENT_TTL_SECONDS=30
EMS_ADDON_SITE_DEFAULT_MODE=ExternalLimits

# Fallbacks used when MQTT payloads omit site context.
EMS_ADDON_DEFAULT_SITE_ID=nexus
EMS_ADDON_DEFAULT_TENANT_ID=1

# Station topology used by policy allocation.
# Option A: comma-separated station IDs
EMS_ADDON_DEFAULT_STATION_IDS=10919352
EMS_ADDON_DEFAULT_STATION_SUPPORTS_V2X=true
EMS_ADDON_DEFAULT_MAX_CHARGE_W=7000
EMS_ADDON_DEFAULT_MAX_DISCHARGE_W=7000

# Option B: full JSON station snapshot list (takes precedence over default IDs)
# EMS_ADDON_STATION_SNAPSHOTS_JSON=[{"stationId":"10919352","online":true,"supportsV2x":false,"maxChargeW":11000}]

EMS_ADDON_DEFAULT_CHARGING_PROFILE_ID=1001

# Citrine target
EMS_ADDON_CITRINE_BASE_URL=http://citrine:8080
EMS_ADDON_CITRINE_TENANT_ID=1

# Ingress options
EMS_ADDON_ENABLE_REST_INGRESS=true
EMS_ADDON_ENABLE_MQTT_INGRESS=true
EMS_ADDON_MQTT_BROKER_URL=mqtt://host.docker.internal:1883
EMS_ADDON_MQTT_TOPIC_PREFIX=ems/site

# Start in dry-run mode for staging validation, then switch to false.
EMS_ADDON_DRY_RUN=true
